### Update user via /users/user/7
PATCH http://localhost:5055/users/user/7
Cookie: access_token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..12ekqAMERPLP2S-HQgu2IRYSWsMhYdZLa3HWI0fqgvY
Content-Type: application/json

{
  "username": "test.vysel",
  "firstname": "Test",
  "lastname": "Vyšel",
  "email": "test@test.cz",
  "tel": "+420987654321"
}

### Get all users /admin/user/index
GET http://localhost:5055/admin/user/index


### Get all banks /admin/bank/index
GET http://localhost:5055/admin/bank/index

### Get user with ID 1 /admin/user/get/1
GET http://localhost:5055/admin/user/get/1

### Get cards for account with ID 1 /admin/card/AccountCards/1
GET http://localhost:5055/admin/card/AccountCards/1

### Get accounts for user with ID 1 /admin/account/SelectByUser/1
GET http://localhost:5055/admin/account/SelectByUser/1

### Get account with ID 2 /admin/account/get/2
GET http://localhost:5055/admin/account/get/2

